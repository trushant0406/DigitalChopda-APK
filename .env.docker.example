# =================================================================
# DigitalChopda.in — Docker Environment Variables
# Copy this file to .env before running: docker compose up -d
# =================================================================

# HTTP Port for public web traffic (default: 80)
PORT_HTTP=80

# PostgreSQL Database credentials
POSTGRES_USER=callintel
POSTGRES_PASSWORD=callintel_secure_pass
POSTGRES_DB=callintel

# JWT secret for session token signing
JWT_SECRET=super_secret_jwt_key_change_in_production_2026

# Web Push Notification keys (VAPID)
VAPID_PUBLIC_KEY=BAzn7LGy6dGVKArSZuhkP_4OTCePSwEMCZ1v1yflIRiywwIp56tfMq45W7OiNrhB4EP_T4TPpm-sA-jZ2kwwhDg
VAPID_PRIVATE_KEY=XkwbRSCeiQtrF9ulQBKgb7verKDMD68N0AeUIlIAceQ
# Follow-up scheduler polling interval (seconds)
REMINDER_POLL_SECONDS=60

# =================================================================
# Object Storage Configuration (Google Cloud Storage / S3 / Local)
# Default is 'local' (files stored in Docker volume backend_uploads)
# =================================================================
STORAGE_PROVIDER=local

# Option 1: Google Cloud Storage (GCS)
# Set STORAGE_PROVIDER=gcs to activate
# GCS_BUCKET_NAME=my-digitalchopda-bucket
# GCS_PROJECT_ID=my-gcp-project-12345
# Choose one of:
# A) Service Account Key file:
# GOOGLE_APPLICATION_CREDENTIALS=/app/gcs-key.json
# B) Inline Service Account credentials:
# GCS_CLIENT_EMAIL=my-sa@my-gcp-project.iam.gserviceaccount.com
# GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk...\n-----END PRIVATE KEY-----\n"

# Option 2: S3-Compatible / Cloudflare R2 / MinIO / AWS S3
# Set STORAGE_PROVIDER=s3 or STORAGE_PROVIDER=r2 to activate
# S3_BUCKET_NAME=my-bucket
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key
# S3_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev

