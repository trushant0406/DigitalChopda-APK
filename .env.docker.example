# =================================================================
# DigitalChopda.in — Docker Environment Variables
# Copy this file to .env before running: docker compose up -d
# =================================================================

# HTTP Port for public web traffic (default: 80)
PORT_HTTP=80

# PostgreSQL Database credentials
POSTGRES_USER=callintel
POSTGRES_PASSWORD=callintel_secure_pass
POSTGRES_DB=callintel

# JWT secret for session token signing
JWT_SECRET=super_secret_jwt_key_change_in_production_2026

# Web Push Notification keys (VAPID)
VAPID_PUBLIC_KEY=BAzn7LGy6dGVKArSZuhkP_4OTCePSwEMCZ1v1yflIRiywwIp56tfMq45W7OiNrhB4EP_T4TPpm-sA-jZ2kwwhDg
VAPID_PRIVATE_KEY=XkwbRSCeiQtrF9ulQBKgb7verKDMD68N0AeUIlIAceQ
# Follow-up scheduler polling interval (seconds)
REMINDER_POLL_SECONDS=60

# =================================================================
# Object Storage Configuration (Cloudflare R2 / AWS S3 / GCS / Local)
# Choose one provider and uncomment its variables
# =================================================================
STORAGE_PROVIDER=r2

# Option 1: Cloudflare R2 (Recommended - 10 GB Free + $0 Egress)
S3_BUCKET_NAME=your-r2-bucket-name
S3_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=your_r2_access_key_id
S3_SECRET_ACCESS_KEY=your_r2_secret_access_key
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# Option 2: AWS S3
# STORAGE_PROVIDER=s3
# S3_BUCKET_NAME=my-aws-s3-bucket
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=AKIA...
# S3_SECRET_ACCESS_KEY=...
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BASE_URL=

# Option 3: Google Cloud Storage (GCS)
# STORAGE_PROVIDER=gcs
# GCS_BUCKET_NAME=my-gcs-bucket
# GCS_PROJECT_ID=my-gcp-project-12345
# GOOGLE_APPLICATION_CREDENTIALS=/app/gcs-key.json

# Option 4: Local Storage (stored in Docker volume backend_uploads)
# STORAGE_PROVIDER=local


