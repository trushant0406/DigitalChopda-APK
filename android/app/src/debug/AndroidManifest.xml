<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Debug-only E2E receiver for local test harness and ADB automation -->
    <application>
        <receiver
            android:name="com.digitalchopda.app.core.receiver.TestE2ESyncReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.digitalchopda.app.ACTION_CREATE_TEST_PARTY" />
                <action android:name="com.digitalchopda.app.ACTION_CREATE_TEST_PAYMENT" />
                <action android:name="com.digitalchopda.app.ACTION_CREATE_ALLOCATED_PAYMENT" />
                <action android:name="com.digitalchopda.app.ACTION_CREATE_TEST_INVOICE" />
                <action android:name="com.digitalchopda.app.ACTION_SYNC_NOW" />
                <action android:name="com.digitalchopda.app.ACTION_SWITCH_COMPANY" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
